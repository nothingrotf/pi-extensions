{
  "name": "@nothingrotf/subdir-context",
  "version": "0.1.0",
  "description": "Load AGENTS.md and CLAUDE.md files of subdirectories when Pi tools touch them",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nothingrotf/pi-extensions",
    "directory": "packages/subdir-context"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@nothingrotf/filetools": "workspace:^",
    "typebox": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
